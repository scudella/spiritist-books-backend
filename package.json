{
  "name": "spiritist-books-backend",
  "version": "4.8.0",
  "description": "Spiritist Books backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "setup-project": "npm i && cd react-client && npm i",
    "setup-production-app": "npm i && cd react-client && npm i &&  npm run build",
    "server": "nodemon index.js",
    "debug": "nodemon --inspect index.js",
    "client": "cd react-client && npm run dev",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "start": "node index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scudella/spiritist-books-backend.git"
  },
  "keywords": [],
  "author": "Eduardo S. Libardi <devscudella@gmail.com> (https://portfolio.scudella.net.br/)",
  "license": "ISC",
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "@scalar/express-api-reference": "^0.10.29",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "datauri": "^4.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "omgopass": "^3.2.1",
    "prom-client": "^15.1.3",
    "spiritist-books": "4.3.0",
    "string-sanitizer": "^2.0.2",
    "uuid": "^14.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/google.accounts": "^0.0.7",
    "axios": "^1.21.0",
    "clean-webpack-plugin": "4.0.0",
    "concurrently": "8.2.1",
    "dotenv-cli": "^11.0.0",
    "nodemon": "3.1.14",
    "postman-to-openapi": "^1.7.3",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.2",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-merge": "6.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
