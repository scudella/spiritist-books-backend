{
  "name": "spiritist-books-backend",
  "version": "4.0.0",
  "description": "Spiritist Books backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "setup-project": "npm i && cd react-client && npm i",
    "setup-production-app": "npm i && cd react-client && npm i &&  npm run build",
    "server": "nodemon server.js",
    "debug": "nodemon --inspect server.js",
    "client": "cd react-client && npm run dev",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "start": "node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scudella/spiritist-books-backend.git"
  },
  "keywords": [],
  "author": "Eduardo S. Libardi <devscudella@gmail.com> (https://portfolio.scudella.net.br/)",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "1.41.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "datauri": "4.1.0",
    "dotenv": "17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "3.1.1",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "8.2.1",
    "fs": "*",
    "google-auth-library": "10.5.0",
    "helmet": "8.1.0",
    "http-status-codes": "2.3.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.19.3",
    "morgan": "1.10.1",
    "multer": "1.4.5-lts.1",
    "nodemailer": "7.0.10",
    "omgopass": "^3.2.1",
    "prom-client": "^15.1.3",
    "spiritist-books": "4.0.0",
    "string-sanitizer": "^2.0.2",
    "uuid": "13.0.0",
    "validator": "13.15.20"
  },
  "devDependencies": {
    "@types/google.accounts": "0.0.7",
    "axios": "1.4.0",
    "clean-webpack-plugin": "4.0.0",
    "concurrently": "8.2.1",
    "nodemon": "3.1.10",
    "ts-loader": "9.4.3",
    "typescript": "5.1.3",
    "webpack": "5.86.0",
    "webpack-cli": "5.1.4",
    "webpack-merge": "5.9.0"
  }
}
